KRONOS_DATABASE_URL=sqlite:///./backend/database/kronos.db
KRONOS_SEED=42
KRONOS_TICK_SECONDS=2
KRONOS_LLM_PROVIDER=mock
KRONOS_LLM_MODEL=deterministic-v1
KRONOS_LLM_RETRIES=1
# Real AI (optional, paid): uv sync --extra anthropic, then set KRONOS_LLM_PROVIDER=anthropic,
# ANTHROPIC_API_KEY, and drop KRONOS_LLM_TIMEOUT (defaults to 20 s) and KRONOS_LLM_MODEL
# (defaults to claude-opus-5-5).
# ANTHROPIC_API_KEY=
# Cost controls for a real provider (defaults shown). Calls per tick is uncapped when unset.
# KRONOS_LLM_CALLS_PER_TICK=6
# KRONOS_LLM_CONCURRENCY=4
# KRONOS_STRATEGIC_LIMIT=12          # strategic citizens (owners first, then by ID)
# KRONOS_STRATEGIC_AGENTS=           # or an explicit comma-separated ID list
# KRONOS_LLM_CACHE=.cache/llm        # response cache; empty disables it
# KRONOS_LLM_CACHE_ONLY=false        # true: replay/demo from the cache, never call the API
# KRONOS_LLM_LOG=                    # e.g. .cache/llm/requests.jsonl (local debug log)
VITE_API_URL=http://localhost:8000
# VITE_OFFLINE=true forces the development fixture; otherwise connection failure enables it.
